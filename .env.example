# OAuth credentials from your PISTE application (the "OAuth Client ID" and "OAuth Secret")
# Not the "API Key" — that is a separate PISTE concept for non-OAuth access
PISTE_CLIENT_ID=your_oauth_client_id_here
PISTE_CLIENT_SECRET=your_oauth_secret_here
PISTE_SANDBOX=true
GOOGLE_API_KEY=your_gemini_api_key_here  # from Google AI Studio: aistudio.google.com
